{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumora.ai/schemas/project-operating-contract.v1.json",
  "title": "Cumora Project Operating Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "repository", "intake", "actions", "checks", "verification", "budgets", "runtime"],
  "properties": {
    "apiVersion": { "const": "cumora.ai/v1alpha1" },
    "kind": { "const": "ProjectOperatingContract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "owners": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "defaultBranch", "branchPrefix", "writablePaths", "protectedPaths"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "branchPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+/$" },
        "writablePaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "protectedPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationMode", "deduplicationWindowHours"],
      "properties": {
        "conversationMode": { "enum": ["disabled", "bound_conversation"] },
        "deduplicationWindowHours": { "type": "integer", "minimum": 1, "maximum": 8760 }
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/actionPolicy" }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "requiredBeforeMerge", "requiredEvidence"],
      "properties": {
        "independent": { "const": true },
        "requiredBeforeMerge": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChangedFiles", "maxAttempts", "maxRuntimeMinutes", "maxModelCostUsd"],
      "properties": {
        "maxChangedFiles": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "maxRuntimeMinutes": { "type": "integer", "minimum": 1 },
        "maxModelCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "leaseMinutes", "unknownAction"],
      "properties": {
        "runner": { "enum": ["codex", "claude", "test"] },
        "leaseMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "unknownAction": { "const": "stop_and_request_decision" }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "sources": { "type": "array", "items": { "enum": ["ci_failure", "production_error", "shipping_readback", "friction"] }, "uniqueItems": true },
        "wipLimit": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "actionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "reason"],
      "properties": {
        "effect": { "enum": ["allow", "deny", "require_approval"] },
        "reason": { "type": "string", "minLength": 1 },
        "approvalRole": { "type": "string" },
        "requiresEvidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "remediation": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "require_approval" } } },
          "then": { "required": ["approvalRole"] }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeoutMinutes"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    }
  }
}
